<UserControl x:Class="CommTT.Modules.SerialProvider.Views.TrafficView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="8">
        <DataGrid ItemsSource="{Binding Frames}" AutoGenerateColumns="False"
                  materialDesign:DataGridAssist.CellPadding="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=\{0:HH:mm:ss.fff\}}" Width="120"/>
                <DataGridTextColumn Header="Data" Binding="{Binding ParsedText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
