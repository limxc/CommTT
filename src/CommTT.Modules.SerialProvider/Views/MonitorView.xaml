<UserControl x:Class="CommTT.Modules.SerialProvider.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <Label Content="Total Frames" Style="{StaticResource MaterialDesignLabel}"/>
            <Label Content="{Binding TotalFrames}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <Label Content="Total Bytes" Style="{StaticResource MaterialDesignLabel}"/>
            <Label Content="{Binding TotalBytes}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <Label Content="Bytes/s" Style="{StaticResource MaterialDesignLabel}"/>
            <Label Content="{Binding BytesPerSecond, StringFormat={}{0:F1}}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
